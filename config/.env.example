# NoneBot2 运行配置
# NapCat 必须能访问 HOST:PORT
HOST=127.0.0.1
PORT=16666

# OneBot v11 反向 WebSocket 认证 Token
# NapCat 端配置相同 token，反向 WebSocket 地址填:
#   ws://<NoneBot可达地址>:<PORT>/onebot/v11/ws
# 例如: ws://127.0.0.1:16666/onebot/v11/ws
ONEBOT_V11_ACCESS_TOKEN=replace-with-a-shared-token

# 逗号分隔的 QQ 群号；先配置一个群即可
TARGET_GROUPS=123456789

# MySQL 连接串（数据库须预先创建，账号需有建表和读写权限）
DATABASE_URL=mysql+asyncmy://community:replace-me@127.0.0.1:3306/crayon_community?charset=utf8mb4

# OpenAI 兼容 LLM 服务
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=your-model-name
LLM_BASE_URL=https://api.openai.com/v1
